href=\"/wxgc-member/icons.svg?v=20260907a#chevron\"></use></svg></button><a class=\"nav-item \" href=\"/creator-workbench/member/settings.html\" data-nav-key=\"settings\" data-tooltip=\"管理会员资料、主题样式、登录安全与邀约记录。\" aria-description=\"管理会员资料、主题样式、登录安全与邀约记录。\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#settings\"></use></svg><span>个人设置</span></a></section><div class=\"nav-scroll-fade-bar\" aria-hidden=\"true\"></div></nav>\n    <div class=\"sidebar-bottom\">\n      <div class=\"sidebar-bottom-row\"><div class=\"mini-membership\" data-settings-link-ready=\"1\" tabindex=\"0\" role=\"link\" aria-label=\"打开个人设置与⚙️ 账户与设置\" title=\"点击打开个人设置与⚙️ 账户与设置\">\n        <div class=\"mini-avatar\" data-member-initial=\"\">演</div>\n        <div><span data-member-name=\"\">演示用户</span><small data-member-level=\"\">天使</small></div>\n        <a href=\"/creator-workbench/member/settings.html\" aria-label=\"打开个人设置\" title=\"打开个人设置与⚙️ 账户与设置\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#chevron\"></use></svg></a>\n      </div>\n      <a class=\"help-button\" href=\"https://wxgaochu.feishu.cn/share/base/webpage/shrcnnUvrmhLammrlrw7Of8QUQf\" target=\"_blank\" rel=\"noopener noreferrer\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#help\"></use></svg><span>使用帮助</span></a>\n      </div>\n    </div>\n  <div class=\"sidebar-resize-handle\" role=\"separator\" aria-orientation=\"vertical\" title=\"拖动调整菜单宽度\"></div></aside>\n\n  <main class=\"workspace-main\">\n    <header class=\"topbar\">\n      <div class=\"topbar-left\">\n        <button class=\"mobile-menu\" type=\"button\" data-open-sidebar=\"\" aria-label=\"打开菜单\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#menu\"></use></svg><b data-nav-mobile-alert=\"\" class=\"nav-alert mobile-menu-alert\" aria-label=\"5 条未读提醒\">5</b></button>\n        <div>\n          <span>MY STARTUP NOTES</span>\n          <div class=\"page-heading-row\"><h1>我的笔记</h1><p class=\"page-intro\" data-page-note=\"\">记想法、存资料，需要时回来看。</p></div>\n        </div>\n      </div>\n      <div class=\"topbar-actions\"><button type=\"button\" class=\"global-search-trigger\" data-open-search=\"\" aria-label=\"打开全站搜索\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#search\"></use></svg><span>搜索</span><kbd>⌘K</kbd></button>\n        <button type=\"button\" class=\"notes-new\" data-notes-new=\"\"><svg aria-hidden=\"true\"><use href=\"/wxgc-member/icons.svg?v=20260907a#note\"></use></svg>新建笔记</button>\n      </div>\n    </header>\n\n    <div class=\"notes-source-tabs\" role=\"tablist\" aria-label=\"笔记来源\">\n      <button type=\"button\" class=\"\" data-notes-source=\"local\" role=\"tab\" aria-selected=\"false\">我的笔记</button>\n      <button type=\"button\" data-notes-source=\"biji\" role=\"tab\" aria-selected=\"true\" class=\"is-active\">得到大脑</button>\n      <button type=\"button\" data-notes-source=\"ima\" role=\"tab\" aria-selected=\"false\">ima</button>\n    </div>\n    <div class=\"notes-layout\" data-notes-layout=\"\" hidden=\"\">\n      <!-- 左：搜索列表区（宽度可拖动） -->\n      <section class=\"notes-list-panel\" id=\"notes-list-region\" data-notes-list-panel=\"\" aria-label=\"搜索列表区\">\n        <button type=\"button\" class=\"notes-back\" data-notes-back=\"\" hidden=\"\">‹ 返回列表</button>\n        <p class=\"notes-zone-label\">搜索列表区</p>\n        <div class=\"notes-list-head\">\n          <input type=\"search\" data-notes-filter=\"\" placeholder=\"搜索：标题、事件、判断、正文…\" aria-label=\"搜索笔记\">\n        </div>\n        <div class=\"notes-filters\">\n          <div class=\"notes-view-pills\" role=\"group\" aria-label=\"笔记视图\">\n            <button type=\"button\" class=\"is-active\" data-notes-view=\"all\">全部</button>\n            <button type=\"button\" data-notes-view=\"followup\">待复盘 <span class=\"notes-pill-count\" data-notes-followup-count=\"\" hidden=\"\">0</span></button>\n          </div>\n          <select class=\"notes-category-select\" data-notes-category=\"\" aria-label=\"按类型筛选\">\n            <option value=\"\">类型</option>\n            <option value=\"customer\">客户</option>\n            <option value=\"product\">产品</option>\n            <option value=\"content\">内容</option>\n            <option value=\"sales\">销售</option>\n            <option value=\"team\">团队</option>\n            <option value=\"operation\">运营</option>\n            <option value=\"finance\">财务</option>\n            <option value=\"self\">自己</option>\n            <option value=\"other\">其他</option>\n          </select>\n          <button type=\"button\" class=\"notes-bulk-toggle\" data-notes-bulk-toggle=\"\">批量删除</button>\n        </div>\n        <div data-smart-note-filter-wrap=\"\"><label>创作材料状态<select class=\"notes-category-select\" data-smart-note-filter=\"\"><option value=\"all\">全部笔记</option><option value=\"pending\">待确认</option><option value=\"confirmed\">已确认</option><option value=\"rejected\">不采用</option></select></label><a href=\"/creator-workbench/member/smart-plans.html#materials\" target=\"_blank\" rel=\"noopener noreferrer\">去批量确认 →</a></div>\n        <ul class=\"notes-list\" data-notes-list=\"\"></ul>\n        <!-- 批量删除操作条：只在「批量删除」模式下出现，平时不占地方 -->\n        <div class=\"notes-bulk-bar\" data-notes-bulk-bar=\"\" hidden=\"\">\n          <span class=\"notes-bulk-count\" data-notes-bulk-count=\"\">勾选要删除的笔记</span>\n          <button type=\"button\" class=\"notes-bulk-all\" data-notes-bulk-all=\"\">全选本页</button>\n          <button type=\"button\" class=\"notes-bulk-delete\" data-notes-bulk-delete=\"\" disabled=\"\">删除所选</button>\n        </div>\n        <!-- 分页：每页 20 条 -->\n        <div class=\"notes-pager\" data-notes-pager=\"\" hidden=\"\"></div>\n        <div class=\"notes-empty\" data-notes-empty=\"\">\n          <p>还没有创业笔记。</p>\n          <p>记下今天发生的一件事，<br>也记下你此刻的判断。</p>\n          <button type=\"button\" data-notes-empty-new=\"\">记录第一条</button>\n        </div>\n        <p class=\"notes-empty\" data-notes-filter-empty=\"\" hidden=\"\">没有匹配的笔记，换个关键词试试。</p>\n      </section>\n\n      <!-- 可拖动分隔条（桌面端显示） -->\n      <div class=\"notes-resizer\" data-notes-resizer=\"\" role=\"separator\" aria-orientation=\"vertical\" aria-label=\"拖动调整列表区宽度\" title=\"拖动调整列表区宽度\"></div>\n\n      <!-- 右：笔记编辑区 -->\n      <section class=\"notes-editor-panel\" data-notes-editor-panel=\"\" aria-label=\"笔记编辑区\">\n        <div class=\"notes-editor-heading\"><p class=\"notes-zone-label\">笔记编辑区</p><button type=\"button\" class=\"notes-list-toggle\" data-notes-list-toggle=\"\" aria-expanded=\"true\" aria-controls=\"notes-list-region\">收起搜索列表 ‹</button></div>\n        <p class=\"notes-editor-placeholder\" data-notes-editor-placeholder=\"\">从左侧选择一条笔记，或新建一条。</p>\n        <form class=\"notes-editor\" data-notes-form=\"\" hidden=\"\" novalidate=\"\">\n          <div class=\"notes-title-row\">\n            <input type=\"text\" class=\"notes-title-input\" data-notes-title=\"\" maxlength=\"120\" placeholder=\"笔记标题（可选）\" aria-label=\"笔记标题\">\n            <button type=\"button\" class=\"notes-title-auto\" data-notes-auto-title=\"\" title=\"自动生成标题：优先取「发生了什么」的第一句\">默认标题</button>\n          </div>\n\n          <!-- 快速记录：轻量结构化区，1-3 分钟能写完；全部可留空 -->\n          <div class=\"notes-quick\">\n            <div class=\"notes-quick-head\"><span>快速记录</span><small>几行就够，也可以只写下面的正文</small></div>\n            <div class=\"notes-quick-meta\">\n            <div class=\"notes-quick-row notes-quick-meta-card\">\n              <span class=\"notes-quick-label\">今天状态</span>\n              <div class=\"notes-moods\" role=\"radiogroup\" aria-label=\"今天状态\">\n                <button type=\"button\" data-notes-mood=\"very_low\" title=\"低谷\">😫</button>\n                <button type=\"button\" data-notes-mood=\"low\" title=\"疲惫\">😕</button>\n                <button type=\"button\" data-notes-mood=\"normal\" title=\"平稳\">🙂</button>\n                <button type=\"button\" data-notes-mood=\"good\" title=\"不错\">😊</button>\n                <button type=\"button\" data-notes-mood=\"high\" title=\"高能\">🔥</button>\n              </div>\n              <span class=\"notes-mood-name\" data-notes-mood-name=\"\"></span>\n            </div>\n            <div class=\"notes-quick-row notes-quick-meta-card\">\n              <span class=\"notes-quick-label\">笔记类型</span>\n              <div class=\"notes-categories\" role=\"radiogroup\" aria-label=\"笔记类型\">\n                <button type=\"button\" data-notes-category-tag=\"customer\">客户</button>\n                <button type=\"button\" data-notes-category-tag=\"product\">产品</button>\n                <button type=\"button\" data-notes-category-tag=\"content\">内容</button>\n                <button type=\"button\" data-notes-category-tag=\"sales\">销售</button>\n                <button type=\"button\" data-notes-category-tag=\"team\">团队</button>\n                <button type=\"button\" data-notes-category-tag=\"operation\">运营</button>\n                <button type=\"button\" data-notes-category-tag=\"finance\">财务</button>\n                <button type=\"button\" data-notes-category-tag=\"self\">自己</button>\n                <button type=\"button\" data-notes-category-tag=\"other\">其他</button>\n              </div>\n            </div>\n            </div>\n            <div class=\"notes-quick-field notes-quick-event\">\n              <span>发生了什么？</span>\n              <textarea data-notes-event=\"\" rows=\"3\" maxlength=\"2000\" placeholder=\"今天发生了什么值得记下的事？\" aria-label=\"发生了什么\"></textarea>\n              <span class=\"notes-quick-count\" data-quick-count=\"event\" aria-live=\"off\">0/2000字符</span>\n            </div>\n            <div class=\"notes-quick-extras\">\n            <details class=\"notes-quick-extra\">\n              <summary>我的判断</summary>\n              <div class=\"notes-quick-field notes-quick-judgment\">\n              <textarea data-notes-judgment=\"\" rows=\"2\" maxlength=\"2000\" placeholder=\"你怎么看这件事？\" aria-label=\"我的判断\"></textarea>\n              <span class=\"notes-quick-count\" data-quick-count=\"judgment\" aria-live=\"off\">0/2000字符</span>\n              </div>\n            </details>\n            <details class=\"notes-quick-extra\">\n              <summary>我的下一步</summary>\n              <div class=\"notes-quick-field notes-quick-decision\">\n              <textarea data-notes-decision=\"\" rows=\"1\" maxlength=\"2000\" placeholder=\"接下来打算怎么做？\" aria-label=\"下一步\"></textarea>\n              <span class=\"notes-quick-count\" data-quick-count=\"decision\" aria-live=\"off\">0/2000字符</span>\n              </div>\n            </details>\n            <details class=\"notes-quick-extra\">\n              <summary>以后回来看看吗</summary>\n              <div class=\"notes-quick-row notes-followup-choice\">\n              <div class=\"notes-followup-pills\" role=\"radiogroup\" aria-label=\"复盘提醒\">\n                <button type=\"button\" class=\"is-active\" data-notes-followup=\"none\">不需要</button>\n                <button type=\"button\" data-notes-followup=\"7d\">7天后</button>\n                <button type=\"button\" data-notes-followup=\"30d\">30天后</button>\n                <button type=\"button\" data-notes-followup=\"custom\">自定义</button>\n              </div>\n              <input type=\"date\" class=\"notes-followup-date\" data-notes-followup-date=\"\" hidden=\"\" aria-label=\"自定义复盘日期\">\n              </div>\n            </details>\n            </div>\n          </div>\n\n          <!-- 详细记录（可选）：现有 Markdown 编辑器，角色=补充背景/会议记录/长篇思考 -->\n          <div class=\"notes-detail\">\n            <div class=\"notes-quick-head\"><span>详细记录</span><small>可选——背景、会议记录、长篇思考、灵感</small></div>\n            <div class=\"notes-toolbar-row\"><div class=\"notes-toolbar\" role=\"toolbar\" aria-label=\"Markdown 快捷插入\">\n              <button type=\"button\" data-md-insert=\"h1\" title=\"一级标题\">H1</button>\n              <button type=\"button\" data-md-insert=\"h2\" title=\"二级标题\">H2</button>\n              <button type=\"button\" data-md-insert=\"bold\" title=\"加粗\"><strong>B</strong></button>\n              <button type=\"button\" data-md-insert=\"list\" title=\"无序列表\">• 列表</button>\n              <button type=\"button\" data-md-insert=\"quote\" title=\"引用\">❝ 引用</button>\n              <button type=\"button\" data-md-insert=\"code\" title=\"代码块\">&lt;/&gt;</button>\n              <button type=\"button\" data-md-insert=\"link\" title=\"链接\">链接</button>\n            </div></div>\n            <div class=\"notes-pane-max-buttons\">\n              <button type=\"button\" data-notes-max=\"edit\">⛶ 最大化编辑</button>\n              <div class=\"notes-preview-bar\">\n                <p class=\"notes-source-link\" data-notes-source-link=\"\" hidden=\"\"></p>\n                <button type=\"button\" class=\"notes-max-preview\" data-notes-max=\"preview\">⛶ 最大化预览</button>\n                <button type=\"button\" class=\"notes-ai-polish\" data-notes-ai-polish=\"\" title=\"把上面的记录整理成一段能直接用的文字\">AI 整理成文</button>\n                <button type=\"button\" class=\"notes-copy-preview\" data-notes-copy-preview=\"\" title=\"复制预览区全部内容\">复制预览内容</button>\n              </div>\n            </div>\n            <div class=\"notes-pane-tabs\" role=\"tablist\" aria-label=\"编辑与预览切换\">\n              <button type=\"button\" class=\"is-active\" data-notes-pane-tab=\"edit\">编辑</button>\n              <button type=\"button\" data-notes-pane-tab=\"preview\">预览</button>\n            </div>\n            <a class=\"notes-course-link\" data-notes-course-link=\"\" hidden=\"\"></a>\n            <div class=\"notes-panes\" data-notes-panes=\"\">\n              <textarea class=\"notes-content-input\" data-notes-content=\"\" rows=\"14\" maxlength=\"20000\" placeholder=\"把想法、资料或沟通内容记在这里。直接输入文字即可。\" aria-label=\"笔记内容\"></textarea>\n              <div class=\"markdown-preview notes-preview\" data-notes-preview=\"\" aria-label=\"排版预览\"></div>\n            </div>\n            <div class=\"notes-count-row\"><span class=\"notes-count\" data-notes-count=\"\" aria-live=\"off\">0/20000字符</span></div>\n\n            <!-- AI 整理结果（一键成段）：只在点了按钮之后出现，不占日常视觉 -->\n            <div class=\"notes-ai-result\" data-notes-ai-result=\"\" hidden=\"\">\n              <div class=\"notes-ai-result-head\">\n                <b>AI 整理结果</b>\n                <span class=\"notes-ai-result-meta\" data-notes-ai-meta=\"\"></span>\n              </div>\n              <div class=\"notes-ai-result-body markdown-preview\" data-notes-ai-body=\"\"></div>\n              <div class=\"notes-ai-result-actions\">\n                <button type=\"button\" class=\"notes-ai-apply\" data-notes-ai-title=\"\" hidden=\"\">用这个标题</button>\n                <button type=\"button\" class=\"notes-ai-apply\" data-notes-ai-replace=\"\">替换正文</button>\n                <button type=\"button\" class=\"notes-ai-apply\" data-notes-ai-append=\"\">追加到正文</button>\n                <button type=\"button\" class=\"notes-ai-discard\" data-notes-ai-discard=\"\">放弃</button>\n              </div>\n              <p class=\"notes-ai-result-status\" data-notes-ai-status=\"\" role=\"status\" aria-live=\"polite\"></p>\n            </div>\n          </div>\n\n          <!-- 后续追踪：仅已保存的笔记显示；新建阶段不出现结果/收获，避免心理负担 -->\n          <div class=\"notes-followup\" data-notes-followup-panel=\"\" hidden=\"\">\n            <div class=\"notes-quick-head\">\n              <span>后续追踪</span>\n              <span class=\"notes-followup-due\" data-notes-followup-due=\"\"></span>\n            </div>\n            <p class=\"notes-followup-due-hint\" data-notes-followup-due-hint=\"\" hidden=\"\">这条笔记已经到复盘时间了，看看后来发生了什么。</p>\n            <div class=\"notes-quick-extras\">\n              <details class=\"notes-quick-extra\">\n                <summary>后来怎么样了？</summary>\n                <div class=\"notes-quick-field notes-quick-result\">\n                  <textarea data-notes-result=\"\" rows=\"2\" maxlength=\"2000\" placeholder=\"结果如何？（填写后这条笔记自动标记为已复盘）\" aria-label=\"后来怎么样了\"></textarea>\n                </div>\n              </details>\n              <details class=\"notes-quick-extra\">\n                <summary>我的收获</summary>\n                <div class=\"notes-quick-field notes-quick-learning\">\n                  <textarea data-notes-learning=\"\" rows=\"2\" maxlength=\"2000\" placeholder=\"这段经历让你学到了什么？（可不填）\" aria-label=\"我的收获\"></textarea>\n                </div>\n              </details>\n            </div>\n          </div>\n\n          <section class=\"notes-calendar-summary\" data-calendar-note-summary=\"\" hidden=\"\" aria-label=\"这篇笔记的日程提醒\" aria-live=\"polite\"></section>\n          <div class=\"notes-editor-foot\" data-notes-foot=\"\">\n            <button type=\"button\" class=\"notes-foot-reveal\" data-notes-foot-reveal=\"\" aria-controls=\"notes-editor-controls\" aria-expanded=\"true\">显示操作 ↑</button>\n            <div class=\"notes-editor-controls\" id=\"notes-editor-controls\" data-notes-foot-controls=\"\">\n            <label class=\"notes-public-toggle\">\n              <input type=\"checkbox\" data-notes-public=\"\">\n              <span>对会员公开（默认私密；勾选并保存后，其他会员可在你的分享页看到这条笔记。分享页需先在「我的个人主页 → 授权访问」开启）</span>\n            </label>\n            <div class=\"notes-editor-actions\">\n              <span class=\"notes-status\" data-notes-status=\"\" role=\"status\" aria-live=\"polite\"></span>\n              <button type=\"button\" class=\"notes-delete\" data-notes-delete=\"\" hidden=\"\">删除</button>\n              <div class=\"notes-primary-actions\">\n                <button type=\"button\" class=\"notes-save\" data-calendar-note-open=\"\" hidden=\"\">设置日程</button>\n                <button type=\"submit\" class=\"notes-save\" data-notes-save=\"\">保存</button>\n              </div>\n            </div>\n            </div>\n          </div>\n        <section class=\"notes-use-panel\" hidden=\"\" aria-label=\"笔记创作用途\"></section><section class=\"notes-consent-host\" hidden=\"\"></section></form>\n      </section>\n    </div>\n\n    <section class=\"biji-panel\" data-biji-panel=\"\" aria-label=\"得到大脑笔记\">\n      <div class=\"biji-card biji-connect\" data-biji-connect=\"\">\n        <p class=\"biji-eyebrow\">GET NOTE · 得到大脑</p>\n        <h2>还没有连接得到大脑</h2>\n        <p class=\"biji-lead\">连上之后，你可以直接在这里搜索、查看你在得到大脑里的笔记，并把需要的那几条一键搬回经营笔记。两边互不干扰，不会互相覆盖。</p>\n        <ol class=\"biji-steps\">\n          <li>打开得到大脑开放平台，创建应用，拿到 Client ID 和 API Key</li>\n          <li>回到「个人设置 → 得到大脑」粘贴并验证</li>\n          <li>回来这里刷新一下就可以用了</li>\n        </ol>\n        <a class=\"biji-primary\" href=\"/creator-workbench/member/settings.html#settings-biji\">去个人设置连接</a>\n        <p class=\"biji-note-warn\">注意：得到大脑的开放接口仅对其付费会员开放。不是得到大脑会员的话，即使填了 Key 也会提示无法使用。</p>\n      </div>\n\n      <div class=\"biji-card biji-body\" data-biji-body=\"\" hidden=\"\">\n        <p class=\"biji-eyebrow\">GET NOTE · 得到大脑　<span data-biji-mask=\"\"></span></p>\n        <div class=\"biji-search-row\">\n          <input type=\"search\" data-biji-query=\"\" placeholder=\"用一句话描述你要找的内容，例如：我上次记的那个用户分层想法\" aria-label=\"语义搜索得到大脑笔记\">\n          <button type=\"button\" class=\"biji-primary\" data-biji-search=\"\">语义搜索</button>\n          <button type=\"button\" class=\"biji-ghost\" data-biji-refresh=\"\">刷新列表</button>\n        </div>\n        <div class=\"biji-filters\">\n          <div class=\"biji-view-pills\" role=\"group\" aria-label=\"得到大脑笔记视图\">\n            <button type=\"button\" class=\"is-active\" data-biji-view=\"all\" aria-pressed=\"true\">全部</button>\n          </div>\n          <span class=\"biji-view-hint\" data-biji-view-hint=\"\">按创建时间倒序，最新在前</span>\n        </div>\n        <p class=\"biji-hint\" data-biji-hint=\"\" hidden=\"\"></p>\n        <p class=\"biji-loading\" data-biji-loading=\"\" hidden=\"\">正在读取…</p>\n        <ul class=\"biji-list\" data-biji-list=\"\"></ul>\n        <p class=\"biji-empty\" data-biji-empty=\"\" hidden=\"\"></p>\n        <div class=\"biji-more-row\"><button type=\"button\" class=\"biji-ghost\" data-biji-more=\"\" hidden=\"\">加载更多</button></div>\n        <div class=\"biji-action-bar\" data-biji-action-bar=\"\" hidden=\"\">\n          <span class=\"biji-action-count\" data-biji-action-count=\"\"></span>\n          <span class=\"biji-action-buttons\">\n            <button type=\"button\" class=\"biji-ghost\" data-biji-clear=\"\">取消选择</button>\n            <button type=\"button\" class=\"biji-primary\" data-biji-import=\"\">导入为经营笔记</button>\n          </span>\n        </div>\n        <p class=\"biji-action-tip\">导入后会在「我的笔记」里生成一份独立副本，之后与得到大脑互不干扰——我们不会自动同步两边，避免误改你的内容。</p>\n        <p class=\"biji-status\" data-biji-status=\"\" role=\"status\" aria-live=\"polite\"></p>\n      </div>\n\n      <div class=\"biji-card biji-detail\" data-biji-detail=\"\" hidden=\"\"></div>\n    </section>\n\n    <section class=\"biji-panel\" data-ima-panel=\"\" hidden=\"\" aria-label=\"ima 笔记\">\n      <div class=\"biji-card biji-connect\" data-ima-connect=\"\" hidden=\"\">\n        <p class=\"biji-eyebrow\">IMA · 我的笔记</p>\n        <h2>还没有连接 ima</h2>\n        <p class=\"biji-lead\">连上之后，你可以直接在这里搜索、查看你在 ima 里的笔记，并把需要的那几条一键搬回经营笔记。两边互不干扰，不会互相覆盖。</p>\n        <ol class=\"biji-steps\">\n          <li>打开 ima 连接配置页，获取 Client ID 和 API Key</li>\n          <li>回到「个人设置 → ima」粘贴并验证</li>\n          <li>回来这里刷新一下就可以用了</li>\n        </ol>\n        <a class=\"biji-primary\" href=\"/creator-workbench/member/settings.html#settings-ima\" target=\"_blank\" rel=\"noopener noreferrer\">去个人设置连接</a>\n        <p class=\"biji-note-warn\">这里只读取你本人有权限的文字笔记；图片、录音和其他附件不搬运。长笔记会完整读取后分篇保存，不会静默截断。</p>\n      </div>\n\n      <div class=\"biji-card biji-body\" data-ima-body=\"\" hidden=\"\">\n        <p class=\"biji-eyebrow\">IMA · 我的笔记　<span data-ima-mask=\"\"></span></p>\n        <div class=\"biji-search-row\">\n          <input type=\"search\" data-ima-query=\"\" placeholder=\"输入正文中的关键词，例如：客户沟通、定位故事\" aria-label=\"搜索 ima 笔记\">\n          <button type=\"button\" class=\"biji-primary\" data-ima-search=\"\">搜索笔记</button>\n          <button type=\"button\" class=\"biji-ghost\" data-ima-refresh=\"\">刷新列表</button>\n        </div>\n        <div class=\"biji-filters\">\n          <div class=\"biji-view-pills\" role=\"group\" aria-label=\"ima 笔记视图\">\n            <button type=\"button\" class=\"is-active\" data-ima-view=\"all\" aria-pressed=\"true\">全部</button>\n          </div>\n          <span class=\"biji-view-hint\" data-ima-view-hint=\"\">按修改时间倒序，最近更新在前</span>\n        </div>\n        <p class=\"biji-hint\" data-ima-hint=\"\" hidden=\"\"></p>\n        <p class=\"biji-loading\" data-ima-loading=\"\" hidden=\"\">正在读取…</p>\n        <ul class=\"biji-list\" data-ima-list=\"\"></ul>\n        <p class=\"biji-empty\" data-ima-empty=\"\" hidden=\"\"></p>\n        <div class=\"biji-more-row\"><button type=\"button\" class=\"biji-ghost\" data-ima-more=\"\" hidden=\"\">加载更多</button></div>\n        <div class=\"biji-action-bar\" data-ima-action-bar=\"\" hidden=\"\">\n          <span class=\"biji-action-count\" data-ima-action-count=\"\"></span>\n          <span class=\"biji-action-buttons\">\n            <button type=\"button\" class=\"biji-ghost\" data-ima-clear=\"\">取消选择</button>\n            <button type=\"button\" class=\"biji-primary\" data-ima-import=\"\">导入为经营笔记</button>\n          </span>\n        </div>\n        <p class=\"biji-action-tip\">导入后会在「我的笔记」里生成一份独立副本，之后与 ima 互不干扰——我们不会自动同步两边，避免误改你的内容。</p>\n        <p class=\"biji-status\" data-ima-status=\"\" role=\"status\" aria-live=\"polite\"></p>\n      </div>\n\n      <div class=\"biji-card biji-detail\" data-ima-detail=\"\" hidden=\"\"></div>\n    </section>\n    <div class=\"workspace-toast\" id=\"workspace-toast\" role=\"status\" aria-live=\"polite\"></div>\n  </main>\n  \n\n  \n  \n  <dialog class=\"notes-fullscreen\" data-notes-fullscreen=\"\" aria-labelledby=\"notes-fullscreen-title\">\n    <header class=\"notes-fullscreen-head\"><h2 id=\"notes-fullscreen-title\" data-notes-fullscreen-title=\"\">详细记录</h2><button type=\"button\" data-notes-fullscreen-close=\"\">退出最大化</button></header>\n    <div class=\"notes-fullscreen-toolbar\" data-notes-fullscreen-toolbar=\"\"></div>\n    <div class=\"notes-fullscreen-content\" data-notes-fullscreen-content=\"\"></div>\n  </dialog>\n  <dialog class=\"notes-calendar\" data-calendar-dialog=\"\" aria-labelledby=\"calendar-note-title\">\n    <header class=\"notes-fullscreen-head\"><h2 id=\"calendar-note-title\">这篇笔记的日程</h2><button type=\"button\" data-calendar-close=\"\">关闭</button></header>\n    <div class=\"notes-calendar-content\" data-calendar-content=\"\">\n      <form data-calendar-form=\"\">\n        <label class=\"notes-calendar-wide\">日程标题 <input name=\"title\" maxlength=\"200\" required=\"\"></label>\n        <label>开始时间（北京时间） <input name=\"start\" type=\"datetime-local\" required=\"\"></label>\n        <label>结束时间（北京时间） <input name=\"end\" type=\"datetime-local\" required=\"\"></label>\n        <label class=\"notes-calendar-wide\">提前提醒 <select name=\"reminder\"><option value=\"\">不提醒</option><option value=\"0\">准时</option><option value=\"5\">5 分钟</option><option value=\"15\">15 分钟</option><option value=\"30\">30 分钟</option><option value=\"60\">1 小时</option><option value=\"1440\">1 天</option></select></label>\n        <fieldset data-calendar-targets=\"\" hidden=\"\"><legend>同步到</legend><div data-calendar-target-list=\"\"></div></fieldset>\n        <p class=\"notes-calendar-hint notes-calendar-wide\">可同步到多个日历；不勾选时，仅保存在会员系统中。</p>\n        <p class=\"notes-calendar-wide\" data-calendar-message=\"\" role=\"status\" aria-live=\"polite\"></p>\n        <div class=\"notes-calendar-actions notes-calendar-wide\">\n        <button type=\"submit\" class=\"notes-save\">保存日程</button>\n        <button type=\"button\" class=\"notes-copy-preview\" data-calendar-edit-cancel=\"\" hidden=\"\">取消修改</button>\n        </div>\n      </form>\n      <section class=\"notes-calendar-history\" aria-labelledby=\"calendar-history-title\"><h3 id=\"calendar-history-title\">已有日程</h3><div data-calendar-list=\"\"></div></section>\n    </div>\n  </dialog>\n  \n  \n  \n  \n\n\n<button type=\"button\" class=\"sidebar-restore\" data-sidebar-restore=\"\" aria-label=\"打开菜单\" title=\"打开菜单\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#menu\"></use></svg></button><div class=\"nav-tooltip\" role=\"tooltip\"></div><div class=\"global-search-dialog\" data-global-search-dialog=\"\" hidden=\"\">\n    <div class=\"global-search-backdrop\" data-close-search=\"\"></div>\n    <section class=\"global-search-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"global-search-title\">\n      <header>\n        <div><span>GLOBAL SEARCH</span><h2 id=\"global-search-title\">全站搜索</h2></div>\n        <button type=\"button\" data-close-search=\"\" aria-label=\"关闭搜索\">×</button>\n      </header>\n      <label class=\"global-search-field\">\n        <svg aria-hidden=\"true\"><use href=\"/wxgc-member/icons.svg?v=20260907a#spark\"></use></svg>\n        <input type=\"search\" autocomplete=\"off\" placeholder=\"搜索你感兴趣的任何内容吧\" aria-label=\"搜索关键词\">\n        <kbd>ESC</kbd>\n      </label>\n      <div class=\"global-search-status\">输入关键词，快速找到可以继续使用的内容。</div>\n      <div class=\"global-search-results\" aria-live=\"polite\"></div>\n    </section></div><div class=\"global-search-dialog daily-action-dialog\" data-daily-action-dialog=\"\" hidden=\"\">\n    <div class=\"global-search-backdrop\" data-close-daily=\"\"></div>\n    <section class=\"global-search-panel daily-action-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"daily-action-title\">\n      <header>\n        <div><span>DAILY CHECK-IN</span><h2 id=\"daily-action-title\">今日行动 <small class=\"daily-action-brand\">每日出摊</small></h2></div>\n        <button type=\"button\" data-close-daily=\"\" aria-label=\"关闭今日行动\">×</button>\n      </header>\n      <p class=\"daily-action-hint\">辛苦一天不容易，赶紧记一笔，再小的成果也是进步。</p>\n      <form data-daily-action-form=\"\" class=\"daily-action-form\">\n        <fieldset>\n          <legend>行动类型 <em class=\"required\">必填</em></legend>\n          <div class=\"daily-action-options\">\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_moments\" data-daily-key-radio=\"\">\n      <span>发了条朋友圈</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"xhs_post\" data-daily-key-radio=\"\">\n      <span>写了篇小红书</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_channels_post\" data-daily-key-radio=\"\">\n      <span>发了视频号</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_oa_post\" data-daily-key-radio=\"\">\n      <span>写了篇公众号</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_oa_card\" data-daily-key-radio=\"\">\n      <span>发布了公众号贴图</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"short_video\" data-daily-key-radio=\"\">\n      <span>发了短视频</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"long_video\" data-daily-key-radio=\"\">\n      <span>发了长视频</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"qa_answer\" data-daily-key-radio=\"\">\n      <span>问答平台答了题</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"client_followup\" data-daily-key-radio=\"\">\n      <span>聊了老客户</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"self_media_post\" data-daily-key-radio=\"\">\n      <span>自媒体平台发文</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"deal_closed\" data-daily-key-radio=\"\">\n      <span>做了个成交</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"private_pool_growth\" data-daily-key-radio=\"\">\n      <span>又加了私域</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"scroll_douyin\" data-daily-key-radio=\"\">\n      <span>学习了抖音对标博主</span>\n    </label></div>\n        </fieldset>\n        <label class=\"daily-action-field\">\n          <span>行动标题</span>\n          <input type=\"text\" name=\"title\" maxlength=\"120\" placeholder=\"选填 · 写下今天发出去的内容标题\" data-daily-title=\"\">\n          <small>带标题的记录会展示在 <a href=\"/creator-workbench/member/member-profile.html\" target=\"_blank\" rel=\"noopener noreferrer\">你的会员主页</a>，点击可直接跳转查看。</small>\n        </label>\n        <label class=\"daily-action-field\">\n          <span>行动网址</span>\n          <input type=\"url\" name=\"url\" maxlength=\"500\" placeholder=\"选填 · 其他会员有权限点击查看\" data-daily-url=\"\">\n          <small>其他会员有权限点击查看。</small>\n        </label>\n        <div class=\"daily-action-actions\">\n          <button type=\"button\" class=\"secondary-action\" data-close-daily=\"\">取消</button>\n          <button type=\"submit\" class=\"meeting-primary\" data-daily-submit=\"\">记一笔今日行动</button>\n        </div>\n        <div class=\"form-status\" data-daily-status=\"\" role=\"status\" aria-live=\"polite\"></div>\n      </form>\n    </section></div><a id=\"bottomBar\" style=\"position: fixed; bottom: -40px; left: 0px; z-index: 9999; transform: translateX(-50%); background-color: transparent; border-radius: 5px 5px 0px 0px; opacity: 0.3; padding: 5px; transition: 0.3s; cursor: pointer; max-height: 100px; max-width: 45px;\"><img src=\"chrome-extension://kobncfkmjelbefaoohoblamnbackjggk/icon/icon_32.png\" style=\"width: 32px; height: 32px;\"></a></body><plasmo-csui id=\"aitdk-csui\"></plasmo-csui><div id=\"immersive-translate-popup\" style=\"all: initial\"></div></html>", "controls": [{"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "隐藏菜单", "value": "", "disabled": false, "attributes": [["data-sidebar-collapse", ""]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "看清业务", "value": "", "disabled": false, "attributes": [["data-tooltip", "先把业务看清：我服务谁、解决什么问题，现在卡在哪，下一步往哪里走。"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "日常工作", "value": "", "disabled": false, "attributes": [["data-tooltip", "每天真正要做的事：让 AI 帮一把、跟进客户、整理会议、记下想法。"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "学习提升", "value": "", "disabled": false, "attributes": [["data-tooltip", "按基本功、进阶打法、真实案例和经营资源四个方向补能力。选一节适合当前问题的课，学完试着用到业务中。"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "会员服务", "value": "", "disabled": false, "attributes": [["data-tooltip", "权益、活动、积分与成长记录，都在这里查看和使用。"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "账户与设置", "value": "", "disabled": false, "attributes": [["data-tooltip", "管理个人资料、主题与账号安全；运营后台仅对有权限的账号显示。"]]}, {"tag": "DIV", "id": "", "text": "何\n演示用户\n天使", "attributes": [["data-settings-link-ready", "1"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "搜索\n⌘K", "value": "", "disabled": false, "attributes": [["data-open-search", ""]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "新建笔记", "value": "", "disabled": false, "attributes": [["data-notes-new", ""]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "我的笔记", "value": "", "disabled": false, "attributes": [["data-notes-source", "local"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "得到大脑", "value": "", "disabled": false, "attributes": [["data-notes-source", "biji"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "ima", "value": "", "disabled": false, "attributes": [["data-notes-source", "ima"]]}]}