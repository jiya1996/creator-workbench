{"key":"super_solo","url":"https://www.wxgaochu.com/super_solo.html","title":"超级个体进化全景与进阶路径","html":"<html lang=\"zh-CN\"><plasmo-csui></plasmo-csui><head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=1920, height=1080\">\n<title>超级个体进化全景与进阶路径</title>\n  <!-- wxgc-share-meta:start -->\n  <meta name=\"description\" content=\"稳步向前，抵达更高处。\">\n  <meta property=\"og:site_name\" content=\"稳行咨询\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:title\" content=\"超级个体进化全景与进阶路径\">\n  <meta property=\"og:description\" content=\"稳步向前，抵达更高处。\">\n  <meta property=\"og:image\" content=\"https://www.wxgaochu.com/assets/img/wxgc-ico.png\">\n  <meta property=\"og:image:width\" content=\"960\">\n  <meta property=\"og:image:height\" content=\"960\">\n  <meta property=\"og:image:alt\" content=\"稳行咨询\">\n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"超级个体进化全景与进阶路径\">\n  <meta name=\"twitter:description\" content=\"稳步向前，抵达更高处。\">\n  <meta name=\"twitter:image\" content=\"https://www.wxgaochu.com/assets/img/wxgc-ico.png\">\n  <meta name=\"wx-share:title\" content=\"超级个体进化全景与进阶路径\">\n  <meta name=\"wx-share:description\" content=\"稳步向前，抵达更高处。\">\n  <meta name=\"wx-share:image\" content=\"https://www.wxgaochu.com/assets/img/wxgc-ico.png\">\n  <!-- wxgc-share-meta:end -->\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    font-family: \"PingFang SC\", \"Microsoft YaHei\", -apple-system, BlinkMacSystemFont, serif;\n    background: #f4ead8;\n    min-height: 100vh;\n    padding: 32px 48px 40px;\n    color: #2b1d10;\n    overflow-x: hidden;\n  }\n\n  .member-fab { position: fixed; top: 20px; right: 28px; z-index: 99;\n    display: inline-flex; align-items: center; gap: 6px;\n    background: #a07a52; color: #fff; text-decoration: none;\n    padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 600;\n    box-shadow: 0 6px 18px rgba(160,122,82,.3); transition: .2s; }\n  .member-fab:hover { background: #8a6540; transform: translateY(-2px); }\n\n  .container { max-width: 1820px; margin: 0 auto; }\n\n  .header { text-align: center; margin-bottom: 26px; }\n  .header .eyebrow {\n    font-size: 13px; letter-spacing: 6px; color: #a07a52;\n    font-weight: 600; margin-bottom: 14px; text-transform: uppercase;\n  }\n  .header h1 {\n    font-family: \"Songti SC\", \"STSong\", \"Noto Serif CJK SC\", \"PingFang SC\", serif;\n    font-size: 52px; font-weight: 800; letter-spacing: 4px; color: #2b1d10; margin-bottom: 8px;\n  }\n  .header .subtitle {\n    font-size: 14px; color: #8a7560; letter-spacing: 5px;\n  }\n\n  .section-title {\n    font-size: 20px; font-weight: 700; letter-spacing: 3px;\n    margin: 22px 0 10px 0; display: flex; align-items: center; gap: 10px;\n    color: #2b1d10;\n    font-family: \"Songti SC\", \"STSong\", \"Noto Serif CJK SC\", serif;\n  }\n  .section-title::before {\n    content: ''; width: 4px; height: 20px; background: #a07a52; border-radius: 2px;\n  }\n\n  /* === 科技感深蓝表格 === */\n  .table-wrapper {\n    background: linear-gradient(135deg, #0f1b4d 0%, #1d4ed8 50%, #3b82f6 100%);\n    border-radius: 16px; overflow: hidden;\n    box-shadow: 0 8px 40px rgba(15,27,77,0.25), 0 0 0 1px rgba(96,165,250,0.25);\n    position: relative;\n  }\n  .table-wrapper::before {\n    content: ''; position: absolute; inset: 0;\n    background: radial-gradient(ellipse at top right, rgba(96,165,250,0.25), transparent 60%);\n    pointer-events: none;\n  }\n\n  table { width: 100%; border-collapse: collapse; font-size: 14px; position: relative; z-index: 1; }\n  thead th {\n    background: rgba(15, 27, 77, 0.55); padding: 13px 10px; text-align: center;\n    font-weight: 700; font-size: 13px; letter-spacing: 1.5px; color: #dbeafe;\n    border-bottom: 1px solid rgba(96, 165, 250, 0.4); white-space: nowrap;\n    text-shadow: 0 0 12px rgba(96,165,250,0.4);\n  }\n  tbody td {\n    padding: 11px 10px; text-align: center; border-bottom: 1px solid rgba(255,255,255,0.06);\n    color: rgba(255,255,255,0.94); line-height: 1.5; vertical-align: middle;\n  }\n  tbody tr:hover { background: rgba(96, 165, 250, 0.08); }\n  tbody tr:last-child td { border-bottom: none; }\n\n  .row-ai {\n    background: linear-gradient(90deg, rgba(96,165,250,0.18), rgba(59,130,246,0.28), rgba(96,165,250,0.18)) !important;\n  }\n  .row-ai td { color: #fff !important; font-weight: 600; text-shadow: 0 0 10px rgba(147,197,253,0.6); }\n  @keyframes pulse-glow {\n    0%, 100% { box-shadow: inset 0 0 20px rgba(96,165,250,0.1); }\n    50% { box-shadow: inset 0 0 30px rgba(96,165,250,0.3); }\n  }\n  .row-ai { animation: pulse-glow 3s ease-in-out infinite; }\n\n  .level-cell { font-weight: 700; font-size: 14px; }\n  .l0-cell { color: #cbd5e1; } .l1-cell { color: #86efac; } .l2-cell { color: #93c5fd; }\n  .l3-cell { color: #c4b5fd; } .l4-cell { color: #fef08a; } .l5-cell { color: #fed7aa; }\n  .l6-cell { color: #fca5a5; }\n\n  .evo-table thead th:nth-child(1){width:10%}.evo-table thead th:nth-child(2){width:10%}\n  .evo-table thead th:nth-child(3){width:14%}.evo-table thead th:nth-child(4){width:18%}\n  .evo-table thead th:nth-child(5){width:16%}.evo-table thead th:nth-child(6){width:16%}\n  .evo-table thead th:nth-child(7){width:16%}\n\n  .path-table thead th:nth-child(1){width:10%}.path-table thead th:nth-child(2){width:14%}\n  .path-table thead th:nth-child(3){width:16%}.path-table thead th:nth-child(4){width:18%}\n  .path-table thead th:nth-child(5){width:16%}.path-table thead th:nth-child(6){width:26%}\n\n  .arrow-divider { text-align:center; color:#a07a52; font-size:22px; margin:14px 0; letter-spacing:8px; opacity:0.7; }\n\n  /* === 底部：三模块公式 + 四模块金句 === */\n  .bottom-section {\n    display: flex;\n    flex-direction: column;\n    gap: 18px;\n    margin-top: 20px;\n  }\n\n  /* === 公式：3个组件 + 等号 + 整体说明 === */\n  .formula-row {\n    display: grid;\n    grid-template-columns: 1.15fr 36px 1.15fr 36px 1.15fr 36px 1.15fr;\n    gap: 12px;\n    align-items: center;\n    background: #fffaf0;\n    border: 1px solid #e8d9be;\n    border-radius: 16px;\n    padding: 22px 28px;\n    box-shadow: 0 4px 16px rgba(160,122,82,0.08);\n  }\n\n.formula-chip {\n    background: linear-gradient(135deg, #f9efe0 0%, #f3e3c7 100%);\n    border: 1px solid #d9bf94;\n    border-radius: 12px;\n    padding: 18px 18px;\n    text-align: center;\n    position: relative;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);\n  }\n  .formula-chip .chip-title {\n    font-size: 19px; font-weight: 800; color: #5a3a1a; letter-spacing: 2px; margin-bottom: 6px;\n  }\n  .formula-chip .chip-desc {\n    font-size: 12px; color: #8a6b48; letter-spacing: 1px; line-height: 1.6;\n  }\n  .formula-chip.positive { border-color: #86b088; }\n  .formula-chip.positive .chip-title { color: #3b6640; }\n  .formula-chip.positive .chip-desc { color: #6b8a6b; }\n  .formula-chip.negative { border-color: #c0907a; }\n  .formula-chip.negative .chip-title { color: #8b3a2a; }\n  .formula-chip.negative .chip-desc { color: #a06b58; }\n\n  .formula-result {\n    background: linear-gradient(135deg, #5a3a1a 0%, #a07a52 100%);\n    border: none;\n    border-radius: 12px;\n    padding: 18px 18px;\n    text-align: center;\n    box-shadow: 0 2px 8px rgba(160,122,82,0.25);\n  }\n  .formula-result .chip-title {\n    font-size: 21px; font-weight: 800; color: #fff; letter-spacing: 2px;\n  }\n  .formula-result .chip-desc {\n    font-size: 12px; color: rgba(255,255,255,0.75); letter-spacing: 1px; margin-top: 4px;\n  }\n\n  .formula-op {\n    text-align: center;\n    font-size: 30px;\n    font-weight: 900;\n    color: #a07a52;\n  }\n\n  /* === 金句：4个时代边界 === */\n  .law-row {\n    background: #fffaf0;\n    border: 1px solid #e8d9be;\n    border-radius: 16px;\n    padding: 20px 24px;\n    box-shadow: 0 4px 16px rgba(160,122,82,0.08);\n  }\n  .law-head {\n    text-align: center;\n    font-size: 14px;\n    color: #8a7560;\n    letter-spacing: 3px;\n    margin-bottom: 14px;\n    font-weight: 600;\n  }\n  .law-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 10px;\n    margin-bottom: 14px;\n  }\n  .law-chip {\n    background: linear-gradient(135deg, #f9efe0 0%, #f3e3c7 100%);\n    border: 1px solid #d9bf94;\n    border-radius: 10px;\n    padding: 14px 12px;\n    text-align: center;\n    position: relative;\n  }\n  .law-chip .law-idx {\n    font-size: 11px;\n    color: #a07a52;\n    letter-spacing: 2px;\n    margin-bottom: 4px;\n    font-weight: 700;\n  }\n  .law-chip .law-title {\n    font-size: 17px;\n    font-weight: 800;\n    color: #5a3a1a;\n    letter-spacing: 2px;\n  }\n  .law-chip .law-arrow {\n    position: absolute;\n    right: -10px;\n    top: 50%;\n    transform: translateY(-50%);\n    font-size: 16px;\n    color: #a07a52;\n    z-index: 1;\n  }\n  .law-chip:last-child .law-arrow { display: none; }\n  .law-tagline {\n    text-align: center;\n    font-size: 17px;\n    font-weight: 800;\n    color: #2b1d10;\n    letter-spacing: 2px;\n    padding-top: 12px;\n    border-top: 1px dashed #e8d9be;\n  }\n  .law-tagline .bolt { color: #d97706; margin-right: 6px; }\n\n  @media (max-width: 1400px) {\n    body { padding: 20px 24px; }\n    .header h1 { font-size: 38px; }\n    .header .eyebrow { font-size: 11px; letter-spacing: 4px; }\n    table { font-size: 12px; } thead th { padding: 9px 6px; font-size: 11px; }\n    tbody td { padding: 7px 6px; font-size: 12px; }\n    .section-title { font-size: 17px; }\n    .formula-chip .chip-title { font-size: 15px; }\n    .formula-chip .chip-desc { font-size: 10px; }\n    .formula-result .chip-title { font-size: 17px; }\n    .formula-result .chip-desc { font-size: 10px; }\n    .formula-op { font-size: 22px; }\n    .law-chip .law-title { font-size: 15px; }\n    .law-tagline { font-size: 14px; }\n  }\n</style>\n  \n  <link rel=\"stylesheet\" href=\"assets/css/visit-counter.css\">\n  <!-- wxgc-wechat-share:start -->\n  \n  <!-- wxgc-wechat-share:end -->\n<link rel=\"icon\"