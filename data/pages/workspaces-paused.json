strong> 条团队邀请</div>\n        <div class=\"ws-invite-list\" data-ws-invite-list=\"\"></div>\n      </section>\n\n      <!-- 客户降温提醒（P0）：最久没联系的客户排最前，点一下直接进跟进表单 -->\n      <section class=\"ws-cooling\" data-ws-cooling=\"\" hidden=\"\" aria-live=\"polite\" aria-label=\"客户降温提醒\"></section>\n\n      <!-- 待办统计 -->\n      <section class=\"ws-stats\" data-ws-stats=\"\" aria-label=\"跟进概览\">\n        <button type=\"button\" class=\"ws-stat ws-stat-click\" data-ws-stat-filter=\"today\"><strong data-ws-stat-today=\"\">0</strong><span>今天待跟进</span></button>\n        <button type=\"button\" class=\"ws-stat ws-stat-warn ws-stat-click\" data-ws-stat-filter=\"overdue\"><strong data-ws-stat-overdue=\"\">0</strong><span>已逾期</span></button>\n        <button type=\"button\" class=\"ws-stat ws-stat-click\" data-ws-stat-filter=\"next7d\"><strong data-ws-stat-next7=\"\">0</strong><span>未来 7 天</span></button>\n      </section>\n\n      <!-- 工具栏 -->\n      <section class=\"ws-toolbar\" aria-label=\"客户检索\">\n        <label class=\"ws-search\">\n          <svg aria-hidden=\"true\"><use href=\"/wxgc-member/icons.svg?v=20260907a#search\"></use></svg>\n          <input type=\"search\" data-ws-q=\"\" placeholder=\"搜索客户名称、企业、联系电话或需求\" aria-label=\"搜索客户\">\n        </label>\n        <div class=\"ws-filter\" role=\"group\" aria-label=\"客户过滤\">\n          <button class=\"\" type=\"button\" data-ws-filter=\"all\">全部</button>\n          <button type=\"button\" data-ws-filter=\"today\" class=\"\">今日</button>\n          <button type=\"button\" data-ws-filter=\"overdue\" class=\"\">已逾期</button>\n          <button type=\"button\" data-ws-filter=\"next7d\" class=\"\">未来 7 天</button>\n          <button type=\"button\" data-ws-filter=\"paused\" class=\"is-active\">已暂停</button>\n          <button type=\"button\" data-ws-filter=\"deleted\">已删除</button>\n        </div>\n        <button type=\"button\" class=\"ws-btn ws-btn-ghost\" data-ws-only-me=\"\" hidden=\"\">只看我负责</button>\n        <button type=\"button\" class=\"ws-btn ws-btn-primary\" data-ws-new=\"\">＋ 新建客户</button>\n      </section>\n\n      <!-- 客户表格 / 卡片 -->\n      <section class=\"ws-customers\" aria-live=\"polite\">\n        <div class=\"ws-table-head\" data-ws-table-head=\"\">\n          <span>客户名称</span><span>当前需求 / 合作事项</span><span>负责人</span><span>下一步 / 跟进时间</span><span>操作</span>\n        </div>\n        <div class=\"ws-list\" data-ws-list=\"\"></div>\n        <div class=\"ws-empty\" data-ws-empty=\"\">\n          <strong>暂无客户</strong><p>点击右上角「新建客户」，把当前跟进的人先记下来。</p>\n        </div>\n        <button class=\"ws-load-more\" type=\"button\" data-ws-more=\"\" hidden=\"\">加载更多</button>\n      </section>\n      <div class=\"ws-list-error\" data-ws-error=\"\" hidden=\"\"></div>\n    </div>\n\n    <section class=\"ws-gate\" data-ws-gate=\"\" hidden=\"\" aria-label=\"功能未开放\">\n      <h2>「我的客户跟进」暂未开放</h2>\n      <p>功能启用后会在这里出现，请稍后再来。</p>\n    </section>\n\n    <!-- 客户详情抽屉 -->\n    <section class=\"ws-drawer\" data-ws-drawer=\"\" hidden=\"\" role=\"dialog\" aria-modal=\"true\" aria-label=\"客户详情\">\n      <div class=\"ws-drawer-mask\" data-ws-drawer-close=\"\"></div>\n      <div class=\"ws-drawer-panel\">\n        <header class=\"ws-drawer-head\">\n          <div>\n            <span class=\"ws-drawer-kicker\" data-ws-drawer-kicker=\"\"></span>\n            <h2 data-ws-drawer-name=\"\"></h2>\n            <p data-ws-drawer-summary=\"\"></p>\n          </div>\n          <button type=\"button\" class=\"ws-icon-btn\" data-ws-drawer-close=\"\" aria-label=\"关闭\">×</button>\n        </header>\n        <div class=\"ws-drawer-tabs\" data-ws-drawer-tabs=\"\">\n          <button class=\"is-active\" type=\"button\" data-ws-tab=\"profile\">基本资料</button>\n          <button type=\"button\" data-ws-tab=\"followups\">沟通记录</button>\n          <button type=\"button\" data-ws-tab=\"plan\">跟进计划</button>\n        </div>\n        <div class=\"ws-drawer-body\" data-ws-drawer-body=\"\"></div>\n        <footer class=\"ws-drawer-actions\" data-ws-drawer-actions=\"\"></footer>\n      </div>\n    </section>\n\n    <!-- 新建 / 编辑客户对话框 -->\n    <section class=\"ws-modal\" data-ws-customer-modal=\"\" hidden=\"\" role=\"dialog\" aria-modal=\"true\" aria-label=\"客户资料\">\n      <div class=\"ws-modal-mask\" data-ws-modal-close=\"\"></div>\n      <form class=\"ws-modal-card\" data-ws-customer-form=\"\" novalidate=\"\">\n        <header><h2 data-ws-form-title=\"\">新建客户</h2><button type=\"button\" class=\"ws-icon-btn\" data-ws-modal-close=\"\" aria-label=\"关闭\">×</button></header>\n        <div class=\"ws-form-grid\">\n          <label>客户名称 *<input name=\"customerName\" required=\"\" maxlength=\"100\" placeholder=\"个人或企业名称\"></label>\n          <label>联系人<input name=\"contactName\" maxlength=\"100\"></label>\n          <label>联系电话<input name=\"contactMethod\" maxlength=\"200\" placeholder=\"手机号 / 其他电话\"></label>\n          <label>企业名称<input name=\"organization\" maxlength=\"100\"></label>\n          <label>来源<input name=\"source\" maxlength=\"100\" placeholder=\"活动 / 介绍 / 微信 / 其他\"></label>\n          <label>本次合作事项<input name=\"cooperationItem\" maxlength=\"200\" placeholder=\"如年度会员、咨询\"></label>\n          <label>合作意向度\n            <select name=\"cooperationLevel\" data-ws-coop-level=\"\">\n              <option value=\"0\">0分｜未判断，还不了解</option>\n              <option value=\"1\">1分｜暂无意向，不考虑</option>\n              <option value=\"2\">2分｜初步了解，先给资料</option>\n              <option value=\"3\">3分｜有意向有需求，愿聊</option>\n              <option value=\"4\">4分｜高意向，在认真考虑</option>\n              <option value=\"5\">5分｜待成交，准备合作</option>\n            </select>\n          </label>\n          <label>当前进度\n            <select name=\"stage\">\n              <option value=\"\">未选择</option>\n              <option value=\"lead\">待了解</option>\n              <option value=\"contacting\">沟通中</option>\n              <option value=\"deciding\">待决定</option>\n              <option value=\"cooperated\">已合作</option>\n              <option value=\"paused\">暂不推进</option>\n            </select>\n          </label>\n          <label>联系偏好\n            <select name=\"contactPreference\">\n              <option value=\"\">未确认</option>\n              <option value=\"reachable\">可联系</option>\n              <option value=\"hold\">暂缓</option>\n              <option value=\"do_not_contact\">不要联系</option>\n            </select>\n          </label>\n          <label class=\"ws-span2\">负责人\n            <select name=\"assigneeUserId\" data-ws-assignee=\"\" class=\"ws-assignee-select\"><option value=\"\">（本人）</option></select>\n          </label>\n          <label class=\"ws-span2\">当前需求<textarea name=\"need\" rows=\"3\" maxlength=\"2000\" placeholder=\"客户当前的需求与背景（最多 2000 字）\"></textarea></label>\n          <label class=\"ws-span2\">备注<textarea name=\"notes\" rows=\"3\" maxlength=\"5000\" placeholder=\"仅供所在空间成员查看（最多 5000 字）\"></textarea></label>\n        </div>\n        <p class=\"ws-form-error\" data-ws-form-error=\"\" hidden=\"\"></p>\n        <footer>\n          <button type=\"button\" class=\"ws-btn\" data-ws-modal-close=\"\">取消</button>\n          <button type=\"submit\" class=\"ws-btn ws-btn-primary\">保存</button>\n        </footer>\n      </form>\n    </section>\n\n    <!-- 团队成员管理对话框 -->\n    <section class=\"ws-modal\" data-ws-members-modal=\"\" hidden=\"\" role=\"dialog\" aria-modal=\"true\" aria-label=\"团队成员\">\n      <div class=\"ws-modal-mask\" data-ws-members-close=\"\"></div>\n      <div class=\"ws-modal-card ws-modal-wide\">\n        <header><h2>团队成员</h2><button type=\"button\" class=\"ws-icon-btn\" data-ws-members-close=\"\" aria-label=\"关闭\">×</button></header>\n        <div class=\"ws-team-name\" data-ws-team-name-box=\"\" hidden=\"\">\n          <label for=\"ws-team-name-input\">团队空间名称</label>\n          <div class=\"ws-team-name-row\">\n            <input id=\"ws-team-name-input\" type=\"text\" maxlength=\"40\" data-ws-team-name-input=\"\" placeholder=\"1–40 字\">\n            <button type=\"button\" class=\"ws-btn ws-btn-primary\" data-ws-team-name-save=\"\">保存名称</button>\n          </div>\n          <p class=\"ws-team-name-hint\" data-ws-team-name-hint=\"\" hidden=\"\"></p>\n        </div>\n        <div class=\"ws-members\" data-ws-members=\"\"></div>\n        <section class=\"ws-invitations\" data-ws-invitations=\"\" hidden=\"\" aria-label=\"邀请记录\">\n          <h3>邀请记录</h3>\n          <ul data-ws-invitation-list=\"\"></ul>\n        </section>\n        <div class=\"ws-invite-form\" data-ws-invite-form=\"\">\n          <h3>邀请新成员</h3>\n          <p class=\"ws-hint\">输入会员完整手机号精确查找；仅返回姓名与脱敏号码。可访问团队空间中全部客户资料及沟通记录（含以后新增的资料）。</p>\n          <div class=\"ws-invite-row\">\n            <input type=\"tel\" data-ws-invite-phone=\"\" placeholder=\"会员手机号\" aria-label=\"会员手机号\">\n            <select data-ws-invite-permission=\"\" aria-label=\"协作权限\">\n              <option value=\"viewer\">仅查看</option>\n              <option value=\"editor\">可编辑</option>\n            </select>\n            <button type=\"button\" class=\"ws-btn ws-btn-primary\" data-ws-invite=\"\">邀请</button>\n          </div>\n          <p class=\"ws-invite-result\" data-ws-invite-result=\"\" hidden=\"\"></p>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ws-toast\" data-ws-toast=\"\" role=\"status\" aria-live=\"polite\"></div>\n  </main>\n  \n\n  \n  \n  \n\n\n<button type=\"button\" class=\"sidebar-restore\" data-sidebar-restore=\"\" aria-label=\"打开菜单\" title=\"打开菜单\"><svg><use href=\"/wxgc-member/icons.svg?v=20260907a#menu\"></use></svg></button><div class=\"nav-tooltip\" role=\"tooltip\"></div><div class=\"global-search-dialog\" data-global-search-dialog=\"\" hidden=\"\">\n    <div class=\"global-search-backdrop\" data-close-search=\"\"></div>\n    <section class=\"global-search-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"global-search-title\">\n      <header>\n        <div><span>GLOBAL SEARCH</span><h2 id=\"global-search-title\">全站搜索</h2></div>\n        <button type=\"button\" data-close-search=\"\" aria-label=\"关闭搜索\">×</button>\n      </header>\n      <label class=\"global-search-field\">\n        <svg aria-hidden=\"true\"><use href=\"/wxgc-member/icons.svg?v=20260907a#spark\"></use></svg>\n        <input type=\"search\" autocomplete=\"off\" placeholder=\"搜索你感兴趣的任何内容吧\" aria-label=\"搜索关键词\">\n        <kbd>ESC</kbd>\n      </label>\n      <div class=\"global-search-status\">输入关键词，快速找到可以继续使用的内容。</div>\n      <div class=\"global-search-results\" aria-live=\"polite\"></div>\n    </section></div><div class=\"global-search-dialog daily-action-dialog\" data-daily-action-dialog=\"\" hidden=\"\">\n    <div class=\"global-search-backdrop\" data-close-daily=\"\"></div>\n    <section class=\"global-search-panel daily-action-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"daily-action-title\">\n      <header>\n        <div><span>DAILY CHECK-IN</span><h2 id=\"daily-action-title\">今日行动 <small class=\"daily-action-brand\">每日出摊</small></h2></div>\n        <button type=\"button\" data-close-daily=\"\" aria-label=\"关闭今日行动\">×</button>\n      </header>\n      <p class=\"daily-action-hint\">辛苦一天不容易，赶紧记一笔，再小的成果也是进步。</p>\n      <form data-daily-action-form=\"\" class=\"daily-action-form\">\n        <fieldset>\n          <legend>行动类型 <em class=\"required\">必填</em></legend>\n          <div class=\"daily-action-options\">\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_moments\" data-daily-key-radio=\"\">\n      <span>发了条朋友圈</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"xhs_post\" data-daily-key-radio=\"\">\n      <span>写了篇小红书</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_channels_post\" data-daily-key-radio=\"\">\n      <span>发了视频号</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_oa_post\" data-daily-key-radio=\"\">\n      <span>写了篇公众号</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"wechat_oa_card\" data-daily-key-radio=\"\">\n      <span>发布了公众号贴图</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"short_video\" data-daily-key-radio=\"\">\n      <span>发了短视频</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"long_video\" data-daily-key-radio=\"\">\n      <span>发了长视频</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"qa_answer\" data-daily-key-radio=\"\">\n      <span>问答平台答了题</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"client_followup\" data-daily-key-radio=\"\">\n      <span>聊了老客户</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"self_media_post\" data-daily-key-radio=\"\">\n      <span>自媒体平台发文</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"deal_closed\" data-daily-key-radio=\"\">\n      <span>做了个成交</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"private_pool_growth\" data-daily-key-radio=\"\">\n      <span>又加了私域</span>\n    </label>\n    <label class=\"daily-action-radio\">\n      <input type=\"radio\" name=\"daily-action-key\" value=\"scroll_douyin\" data-daily-key-radio=\"\">\n      <span>学习了抖音对标博主</span>\n    </label></div>\n        </fieldset>\n        <label class=\"daily-action-field\">\n          <span>行动标题</span>\n          <input type=\"text\" name=\"title\" maxlength=\"120\" placeholder=