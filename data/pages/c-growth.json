{"key": "c-growth", "url": "https://wxgaochu.com/products/c-growth.html", "title": "一人公司产品 · 创作工作台", "html": "<html lang=\"zh-CN\" data-immersive-translate-page-theme=\"light\"><plasmo-csui></plasmo-csui><head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>一人公司产品 · 创作工作台</title>\n  <!-- wxgc-share-meta:start -->\n  <meta name=\"description\" content=\"创作工作台一人公司产品：AI超级个体年度实战会员、高客单IP一人公司半年度私教班——帮专业服务者把能力变成产品，把内容变成客户。\">\n  \n  \n  \n  \n  \n  \n  \n  \n  <meta name=\"twitter:card\" content=\"summary_large_image\">\n  <meta name=\"twitter:title\" content=\"一人公司产品 · 创作工作台\">\n  <meta name=\"twitter:description\" content=\"创作工作台一人公司产品：AI超级个体年度实战会员、高客单IP一人公司半年度私教班——帮专业服务者把能力变成产品，把内容变成客户。\">\n  <meta name=\"twitter:image\" content=\"https://www.wxgaochu.com/assets/img/wxgc-ico.png\">\n  <meta name=\"wx-share:title\" content=\"一人公司产品 · 创作工作台\">\n  <meta name=\"wx-share:description\" content=\"创作工作台一人公司产品：AI超级个体年度实战会员、高客单IP一人公司半年度私教班——帮专业服务者把能力变成产品，把内容变成客户。\">\n  <meta name=\"wx-share:image\" content=\"https://www.wxgaochu.com/assets/img/wxgc-ico.png\">\n  <!-- wxgc-share-meta:end -->\n<meta name=\"description\" content=\"创作工作台一人公司产品：AI超级个体年度实战会员、高客单IP一人公司半年度私教班——帮专业服务者把能力变成产品，把内容变成客户。\">\n<link rel=\"stylesheet\" href=\"../assets/css/main.css\">\n<link rel=\"stylesheet\" href=\"../assets/css/member-posters.css\">\n<noscript><style>.poster-wall .poster{opacity:1 !important;transform:none !important}</style></noscript>\n  \n  \n  <link rel=\"stylesheet\" href=\"../assets/css/visit-counter.css\">\n  <!-- wxgc-wechat-share:start -->\n  \n  <!-- wxgc-wechat-share:end -->\n</head>\n<body>\n\n  <!-- 导航：构建时由 partials/nav.html 注入 -->\n  <nav class=\"nav\" id=\"nav\" aria-label=\"网站主导航\">\n  <div class=\"inner\">\n    <a href=\"../index.html\" class=\"brand\"><span class=\"brand-text\">创作工作台</span></a>\n    <button class=\"nav-toggle\" id=\"navToggle\" type=\"button\" aria-label=\"展开导航菜单\" aria-controls=\"menu\" aria-expanded=\"false\">☰</button>\n    <div class=\"menu\" id=\"menu\">\n      <a href=\"../index.html\">首页</a>\n      <a href=\"../index.html#founder\">主理人</a>\n      <a href=\"../products/life-story.html\">传家故事书</a>\n      <a href=\"../products/ip-growth.html\">创始人IP增长系统</a>\n      <a href=\"../products/c-growth.html\" aria-current=\"page\">一人公司</a>\n      <a href=\"../products/salon.html\">会员沙龙</a>\n      <a href=\"../opc.html\">OPC工作台</a>\n      <a href=\"../index.html#contact\" class=\"cta-link\">联系我们</a>\n      <a href=\"https://www.wxgaochu.com/member/\" class=\"cta-member\">会员中心</a>\n    </div>\n  </div>\n</nav>\n\n\n\n  <!-- HERO -->\n  <header class=\"page-hero\">\n    <div class=\"kicker\">创作工作台 · 一人公司产品</div>\n    <h1>有真本事，不等于会<span class=\"em\">经营</span>。<br>真正重要的，<br>是跑通自己的<span class=\"em\">商业闭环</span></h1>\n    <p class=\"lead\">用 6 个月或一年的时间，把专业能力变成产品，<br>把内容变成客户，跑通一套可持续经营的个人增长模型。</p>\n    <div class=\"actions\">\n      <a class=\"btn\" href=\"https://www.wxgaochu.com/payment.html?sku=ai_super_individual_annual\" target=\"_blank\" rel=\"noopener\">点击加入AI超级个体联盟</a>\n    </div>\n  </header>\n\n  <!-- ============================================================ -->\n  <!-- 产品一：AI超级个体年度实战会员（展示价格） -->\n  <!-- ============================================================ -->\n  <section id=\"member\">\n    <div class=\"wrap\">\n      <div class=\"sec-sub\" style=\"text-align:left;letter-spacing:.12em;margin-bottom:8px;font-size:14px;color:var(--gold)\">一人公司 01</div>\n      <h2 class=\"sec-title\" style=\"text-align:left\">AI超级个体年度实战会员</h2>\n      <div style=\"display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:28px\">\n        <span style=\"background:var(--gold);color:#fff;padding:6px 18px;border-radius:30px;font-size:14px;font-weight:700;letter-spacing:.06em\">首发会员价：1286元/年</span>\n        <span style=\"color:var(--ink-soft);font-size:15px\">正式价3986元/年｜入会即开通 <a href=\"https://www.wxgaochu.com/opc.html\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--gold-deep);font-weight:600;text-decoration:underline;text-underline-offset:2px\">OPC工作台</a>｜7日不适合可全额退款</span>\n      </div>\n\n      <p class=\"lead\" style=\"margin-bottom:24px\">如果你有专业、有产品或已经在持续创作，却被内容产能、个人IP和获客效率卡住——这个年度会员将帮你搭出一套真正服务你业务的 AI 获客工作流。</p>\n\n      <div class=\"quote\" style=\"margin-bottom:36px;text-align:left\">\n        \"一个人 + 一套 AI 工作流 ≈ 过去一个小团队的产能。<br>你不会被 AI 替代，但会被「会用 AI 的同行」甩开。\"\n      </div>\n\n      <!-- 会员年度海报墙（源自 OPC 工作台演示 · 第43页） -->\n      <div class=\"poster-wall\" data-poster-wall=\"\">\n        <div class=\"poster-wall-head\">\n          <div class=\"poster-wall-kicker\">AI 超级个体联盟 · 年度实战会员</div>\n          <h3 class=\"poster-wall-title\">一个人，也能拥有一支 AI 团队</h3>\n        </div>\n        <div class=\"poster-wall-rail\">\n          <button class=\"poster\" type=\"button\" data-poster-full=\"../assets/img/cg-member-poster-1.jpg\" aria-label=\"放大查看：AI超级个体联盟年度实战会员主视觉\">\n            <img src=\"../assets/img/cg-member-poster-1.jpg\" width=\"620\" height=\"1102\" loading=\"lazy\" decoding=\"async\" alt=\"AI超级个体联盟年度实战会员：365天一人公司AI升级计划，首发会员价 ¥1286/365天\">\n          </button>\n          <button class=\"poster\" type=\"button\" data-poster-full=\"../assets/img/cg-member-poster-2.jpg\" aria-label=\"放大查看：加入会员你将获得什么\">\n            <img src=\"../assets/img/cg-member-poster-2.jpg\" width=\"620\" height=\"1102\" loading=\"lazy\" decoding=\"async\" alt=\"加入会员你将获得：AI员工中心、每周AI实战、月度直播答疑、年度资料库与社群\">\n          </button>\n          <button class=\"poster\" type=\"button\" data-poster-full=\"../assets/img/cg-member-poster-3.jpg\" aria-label=\"放大查看：这一年我们一起完成4件事\">\n            <img src=\"../assets/img/cg-member-poster-3.jpg\" width=\"620\" height=\"1102\" loading=\"lazy\" decoding=\"async\" alt=\"这一年我们一起完成4件事：搭建你的AI工作团队、跑通内容获客系统、建立一人公司经营系统、沉淀自己的AI工作流\">\n          </button>\n          <button class=\"poster\" type=\"button\" data-poster-full=\"../assets/img/cg-member-poster-4.jpg\" aria-label=\"放大查看：适合哪些人与全年交付节奏\">\n            <img src=\"../assets/img/cg-member-poster-4.jpg\" width=\"620\" height=\"1102\" loading=\"lazy\" decoding=\"async\" alt=\"适合哪些人：超级个体/一人公司、创始人/小团队负责人、专业服务者/知识IP、正在探索AI的人；全年交付节奏：每周内容、每月直播、每季度复盘、全年持续更新\">\n          </button>\n          <button class=\"poster\" type=\"button\" data-poster-full=\"../assets/img/cg-member-poster-5.jpg\" aria-label=\"放大查看：谁在陪你一起实战\">\n            \n          </button>\n        </div>\n        <p class=\"poster-wall-note\"><span>365 天一人公司 AI 升级计划</span><span>首发会员价 <b>¥1,286</b>/年（正式价 ¥3,986）</span></p>\n        <p class=\"poster-wall-hint\">点击海报可放大查看</p>\n      </div>\n\n\n      <!-- 核心权益 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:0 0 20px\">会员一年，你能拿到什么</h3>\n      <div class=\"prod-grid\" style=\"margin-bottom:10px\">\n        <div class=\"prod flag\">\n          <div class=\"stage\">每周更新</div>\n          <h3>52期AI实战内容</h3>\n          <p>每期只解决一个具体问题，附一个「建议行动」。不堆知识，不强制打卡。围绕你的业务目标按需实践。</p>\n        </div>\n        <div class=\"prod flag\">\n          <div class=\"stage\">每月直播</div>\n          <h3>12场AI获客增长会</h3>\n          <p>当月值得关注的AI变化 → 真实案例拆解 → 会员问题现场诊断 → 本月行动任务。</p>\n        </div>\n        <div class=\"prod\">\n          <div class=\"stage\">工具与资料</div>\n          <h3>全年资料库 + 智能体体验</h3>\n          <p>实战内容、直播回放、工具模板、提示词持续沉淀；每月开放AI智能体（定位罗盘、获客短视频脚本等）。</p>\n        </div>\n        <div class=\"prod\">\n          <div class=\"stage\">社群与样板间</div>\n          <h3>专属社群 + 企业应用样板间</h3>\n          <p>每季度1次企业AI应用样板间拆解；千人社群交流经验、认识同阶段的专业人士。</p>\n        </div>\n        <div class=\"prod prod-wide flag\">\n          <div class=\"prod-wide-heading\">\n            <div class=\"stage\">年度共创 · 6次 × 1.5小时</div>\n            <h3>6次线上沙龙实操课</h3>\n          </div>\n          <div class=\"prod-wide-body\">\n            <p>围绕 WorkBuddy 自动化、Codex 开发、小红书图文生成、知识卡片制作、爆款短视频仿写等一人公司高频场景，现场拆解、同步实操、集中答疑。带着自己的业务素材来，每次争取完成一份可以直接发布、复用或继续迭代的成果。</p>\n            <div class=\"suit\"><b>每次带走：</b>1份业务成果 + 1套可复用流程 + 1轮现场校准</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 入会即赠 -->\n      <div style=\"background:linear-gradient(135deg,#f5e6a8,#f0d878);border-radius:16px;padding:28px 32px;margin-top:24px;border:1px solid rgba(176,125,79,.25)\">\n        <h4 style=\"margin:0 0 12px;color:#7a5018;font-size:19px\">入会即赠：AI获客实战启动包</h4>\n        <p style=\"margin:0;color:#5c4012;font-size:15.5px;line-height:1.75\">《AI获客7堂课》+ 定位罗盘智能体 + 获客短视频智能体 —— 加入第一天就有工具、有路径，马上完成第一轮实践。</p>\n      </div>\n\n      <!-- 四个成果阶段 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:40px 0 20px\">一年时间，围绕四个真实成果推进</h3>\n      <div class=\"step-grid\">\n        <div class=\"step\"><div class=\"no\">01</div><h3>建立稳定的AI工作方式</h3><p>不再每次从空白对话框开始，逐步建立适合自己的工具、指令和工作台。</p></div>\n        <div class=\"step\"><div class=\"no\">02</div><h3>搭出第一条专业AI工作流</h3><p>从你的职业和业务场景出发，把一个高频任务沉淀成可重复调用的流程。</p></div>\n        <div class=\"step\"><div class=\"no\">03</div><h3>用AI建立个人影响力</h3><p>让专业能力被更多人看见、理解和信任，围绕客户决策路径持续输出。</p></div>\n        <div class=\"step\"><div class=\"no\">04</div><h3>让AI进入商业经营</h3><p>从提升效率升级到用AI经营事业——私域、成交、产品、复盘全链路。</p></div>\n      </div>\n\n      <!-- 真实案例 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:44px 0 20px\">真实案例比履历更有说服力</h3>\n      <div class=\"case-grid\">\n        <a class=\"case\" href=\"https://weixin.qq.com/sph/AqdfsQKlLb\" target=\"_blank\" rel=\"noopener\" style=\"text-decoration:none\">\n          <div class=\"case-tag\">律师行业</div>\n          <h3>贺律律：单条视频10万+播放</h3>\n          <p>使用获客型短视频智能体完成选题与脚本优化，视频号单条视频获得10万+播放，转发6000余次，近百人咨询。</p>\n          <div class=\"more\">▶ 查看视频案例</div>\n        </a>\n        <a class=\"case\" href=\"https://weixin.qq.com/sph/AGnqW94RAX\" target=\"_blank\" rel=\"noopener\" style=\"text-decoration:none\">\n          <div class=\"case-tag\">幼教行业</div>\n          <h3>Yvonne刘园长：80万播放，100+线索</h3>\n          <p>北京蒙氏高端国际幼儿园园长，使用获客型短视频智能体，单条视频全平台80万播放，获客效率翻倍。她说：“真的是简单、好用、有结果”！</p>\n          <div class=\"more\">▶ 查看视频案例</div>\n        </a>\n      </div>\n\n      <!-- 适合谁 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:44px 0 20px\">谁适合加入？谁不适合？</h3>\n      <div class=\"cols-2\">\n        <div class=\"col\">\n          <h3 style=\"color:var(--gold-deep)\">特别适合</h3>\n          <ul>\n            <li>有专业能力，想用AI提升效率和影响力的人</li>\n            <li>专家、顾问、教练、讲师、律师等专业服务者</li>\n            <li>有产品、有客户，但获客和内容不稳定的老板</li>\n            <li>想建立个人IP却不知道如何持续表达的人</li>\n            <li>愿意动手实践，而不是只收藏资料的人</li>\n          </ul>\n        </div>\n        <div class=\"col\">\n          <h3 style=\"color:var(--ink-soft)\">暂时不适合</h3>\n          <ul>\n            <li>只想领资料、不愿意动手实践的人</li>\n            <li>希望有人每天监督打卡、逐条代写代改的人</li>\n            <li>期待以会员年费获得企业级咨询或代运营的人</li>\n            <li>没有真实业务场景、只想追AI热点的人</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- CTA for member -->\n      <div style=\"text-align:center;margin-top:48px;padding:34px;background:linear-gradient(135deg,var(--gold),var(--gold-deep));border-radius:20px;box-shadow:var(--shadow)\">\n        <h3 style=\"color:#fff;margin:0 0 8px;font-size:24px\">首发会员价：1286元/年（日均不到4块钱）</h3>\n        <p style=\"color:#f6efe2;margin:0 0 22px;font-size:16px\">入会即开通 <a href=\"https://www.wxgaochu.com/opc.html\" target=\"_blank\" rel=\"noopener\" style=\"color:#fff;font-weight:600;text-decoration:underline;text-underline-offset:2px\">OPC工作台</a>｜7日不适合可全额退款</p>\n        <a class=\"btn\" href=\"https://www.wxgaochu.com/payment.html?sku=ai_super_individual_annual\" target=\"_blank\" rel=\"noopener\" style=\"background:#fff;color:var(--gold-deep);border-color:#fff;font-weight:700\">点击报名</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- 分隔 -->\n  <div style=\"height:1px;background:var(--line);max-width:200px;margin:0 auto\"></div>\n\n  <!-- ============================================================ -->\n  <!-- 产品二：高客单IP一人公司半年度私教班（不展示价格） -->\n  <!-- ============================================================ -->\n  <section class=\"bg-warm\" id=\"coaching\">\n    <div class=\"wrap\">\n      <div class=\"sec-sub\" style=\"text-align:left;letter-spacing:.12em;margin-bottom:8px;font-size:14px;color:var(--gold)\">一人公司 02</div>\n      <h2 class=\"sec-title\" style=\"text-align:left\">高客单IP一人公司<br>半年度私教班</h2>\n      <div style=\"display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:28px\">\n        <span style=\"background:var(--ink);color:#f6efe2;padding:6px 18px;border-radius:30px;font-size:14px;font-weight:700;letter-spacing:.06em\">每期限额12人</span>\n        <span style=\"color:var(--ink-soft);font-size:15px\">6个月深度经营孵化｜添加微信咨询详情</span>\n      </div>\n\n      <p class=\"lead\" style=\"margin-bottom:24px\">这不是一门 IP 课程，而是 6 个月经营孵化。<br>你带着真实业务入场，每月攻克一个经营环节——毕业标准不是「听完多少节课」，而是你是否跑通了一套能继续运转的一人公司模型。</p>\n\n      <div class=\"quote\" style=\"margin-bottom:36px;text-align:left\">\n        \"真正限制你的，不是专业能力，而是能力还没完成商业化、产品化和系统化。<br>中3条以上，你需要的不是再学一个流量技巧，而是重建一套从定位到交付的经营模型。\"\n      </div>\n\n      <!-- 七步模型 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:0 0 20px\">七步经营模型 × 六个月路径</h3>\n      <div class=\"step-grid\">\n        <div class=\"step\"><div class=\"no\">01</div><h3>定位诊断</h3><p>60分钟一对一经营诊断，锁定半年最需突破的3个核心问题。</p></div>\n        <div class=\"step\"><div class=\"no\">02</div><h3>产品体系</h3><p>黄金客户画像 + 高客单产品方案，让客户知道你为什么值得付高价。</p></div>\n        <div class=\"step\"><div class=\"no\">03</div><h3>标准表达</h3><p>一句话定位、30秒/3分钟介绍、案例表达、咨询入口校准。</p></div>\n        <div class=\"step\"><div class=\"no\">04</div><h3>内容系统</h3><p>四类内容组合 + 3条战略置顶脚本 + 至少1条代表性视频指导。</p></div>\n        <div class=\"step\"><div class=\"no\">05</div><h3>获客成交</h3><p>聚焦1–2个重点渠道，打通引流、标签分层、七次触达、诊断成交全流程。</p></div>\n        <div class=\"step\"><div class=\"no\">06</div><h3>AI数字员工</h3><p>开放更多 AI 员工岗位 + 50份实操工具，覆盖调研、选题、脚本、复盘等场景。</p></div>\n        <div class=\"step\"><div class=\"no\">07</div><h3>经营资产沉淀</h3><p>限额私教校准 + 经营者同学圈 + 至少1次北京线下闭门交流。</p></div>\n        <div class=\"step\"><div class=\"no\">✓</div><h3>毕业标准</h3><p>不是听完课，而是跑通一套能继续运转的一人公司模型。</p></div>\n      </div>\n\n      <!-- 九大权益 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:40px 0 20px\">九大核心权益</h3>\n      <ul class=\"list\">\n        <li><b>入学诊断与路线图</b> — 60分钟一对一经营诊断，锁定半年最需突破的3个核心问题</li>\n        <li><b>定位与产品体系</b> — 黄金客户画像＋高客单产品方案，让客户知道你为什么值得付高价</li>\n        <li><b>标准表达与主页升级</b> — 一句话定位、30秒/3分钟介绍、案例表达、咨询入口校准</li>\n        <li><b>内容系统与代表作</b> — 四类内容组合＋3条战略置顶脚本＋至少1条代表性视频（含指导）</li>\n        <li><b>视觉六件套与数字展厅</b> — 社交名片、朋友圈背景、产品海报等统一视觉资产（模板与审校）</li>\n        <li><b>获客·私域·成交系统</b> — 聚焦1–2个重点渠道，打通引流、标签分层、七次触达、诊断成交全流程</li>\n        <li><b>开放更多 AI 员工岗位＋50份实操工具</b> — 覆盖调研、选题、脚本、复盘等场景；AI辅助提效，决策在你</li>\n        <li><b>限额私教与校准</b> — 6次月度私教课＋6次项目门诊＋3次一对一校准＋班级群答疑（限12人）</li>\n        <li><b>经营者同学圈</b> — 跨行业案例拆解、项目路演，至少1次北京线下闭门交流</li>\n      </ul>\n\n      <!-- 真实案例 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:44px 0 20px\">真实案例：专业能力如何变成商业结果</h3>\n      <div class=\"case-grid\">\n        <div class=\"case\" style=\"cursor:default\">\n          <div class=\"case-tag\">声音教练</div>\n          <h3>声音教练昕楠：单日直播发售35万+</h3>\n          <p>从低客单课程转向高客单产品体系，重建定位与集中成交路径后，单日直播发售35万元以上。</p>\n        </div>\n        <div class=\"case\" style=\"cursor:default\">\n          <div class=\"case-tag\">太极教练</div>\n          <h3>太极教练红霞：两轮收入近40万</h3>\n          <p>长期直播无成交，重建定位与集中成交路径后，两轮项目收入近40万元。</p>\n        </div>\n        <div class=\"case\" style=\"cursor:default\">\n          <div class=\"case-tag\">愈疗师</div>\n          <h3>苗愈师：首轮线上发售106万+</h3>\n          <p>20多年线下积累依赖熟人介绍，系统搭建IP与产品后，首轮线上发售106万元以上。</p>\n        </div>\n      </div>\n      <p style=\"text-align:center;color:var(--ink-soft);font-size:13.5px;margin-top:16px;font-style:italic\">案例结果与客户基础、执行和市场环境相关，不构成对学员的结果承诺。</p>\n\n      <!-- 适合谁 -->\n      <h3 style=\"font-size:22px;color:var(--gold-deep);margin:44px 0 20px\">谁适合，谁不适合</h3>\n      <div class=\"cols-2\">\n        <div class=\"col\">\n          <h3 style=\"color:var(--gold-deep)\">适合</h3>\n          <ul>\n            <li>3年以上专业积累、有真实客户和可核验案例</li>\n            <li>已有付费成交但订单不稳定</li>\n            <li>愿意本人参与并每周投入6–8小时</li>\n            <li>专业服务者与内容创业者</li>\n          </ul>\n        </div>\n        <div class=\"col\">\n          <h3 style=\"color:var(--ink-soft)\">不适合</h3>\n          <ul>\n            <li>专业能力尚未形成</li>\n            <li>指望一条视频快速翻身</li>\n            <li>只想买模板不愿实操</li>\n            <li>要求代运营代销售</li>\n            <li>已有成熟企业团队（更适合B端解决方案）</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- CTA for coaching (no price) -->\n      <div style=\"text-align:center;margin-top:48px;padding:34px;background:linear-gradient(135deg,#2c261f,#4a4036);border-radius:20px;box-shadow:var(--shadow)\">\n        <h3 style=\"color:#fff;margin:0 0 8px;font-size:24px\">每期限额12人 · 需适配度评估</h3>\n        <p style=\"color:#e9dcc8;margin:0 0 22px;font-size:16px\">提交信息 → 适配度沟通 → 确认班级与交付边界 → 进入半年经营周期</p>\n        <a class=\"btn\" id=\"wechatCtaCoaching\" href=\"javascript:void(0)\" data-wechat=\"361453605\">添加微信 · 咨询详情</a>\n        <div class=\"note\" style=\"margin-top:16px;color:#c9bca8;font-size:13px\">创作工作台 · 高客单IP一人公司半年度私教班</div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 为什么跟学 -->\n  <section class=\"bg-paper\">\n    <div class=\"wrap\">\n      \n      <div class=\"sec-sub\">WHY XU FENG</div>\n      <div class=\"quote\">\n        \"更擅长解决的不是「怎样多做一点」，而是「资源有限时，最该先解决哪个问题」。\"\n        <span>—— 约10年技术架构经验（中国电信、京东、万达电影）；2019年起深耕IP商业化与高客单发售；今天他就是AI超级个体的样本。</span>\n      </div>\n      <div class=\"stats\" style=\"margin-top:54px\">\n        <div class=\"stat\"><div class=\"num\">10+</div><div class=\"lab\">年技术架构与企业流程经验</div></div>\n        <div class=\"stat\"><div class=\"num\">2019</div><div class=\"lab\">起深耕IP商业化与高客单发售</div></div>\n        <div class=\"stat\"><div class=\"num\">2000万+</div><div class=\"lab\">累计帮助个体IP实现业绩</div></div>\n        <div class=\"stat\"><div class=\"num\">数十款</div><div class=\"lab\">自研AI智能体与工作流</div></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 全局CTA -->\n  <section class=\"cta\">\n    <h2>找到适合你的成长路径</h2>\n    <p>无论是想用AI提效的年度会员，还是想系统化经营的一人公司私教班，<br>都欢迎先聊一次——看清你的情况，再决定下一步。</p>\n    <a class=\"btn\" id=\"wechatCta\" href=\"javascript:void(0)\" data-wechat=\"361453605\">添加微信 · 复制微信号</a>\n    <div class=\"note\">微信号：361453605　|　创作工作台（北京）教育咨询有限公司</div>\n  </section>\n\n  <!-- 页脚 -->\n  <footer>\n    <div class=\"f-brand\">创作工作台</div>\n    <div>把IP做成生意，把故事写成传承。</div>\n    <div class=\"f-links\">\n      <a href=\"../index.html\">首页</a>\n      <a href=\"../index.html#founder\">主理人</a>\n      <a href=\"life-story.html\">传家故事书</a>\n      <a href=\"ip-growth.html\">创始人IP增长系统</a>\n      <a href=\"c-growth.html\">一人公司</a>\n      <a href=\"salon.html\">会员沙龙</a>\n      <a href=\"https://www.wxgaochu.com/opc.html\" target=\"_blank\" rel=\"noopener\">OPC工作台</a>\n      <a href=\"../index.html#contact\">联系我们</a>\n    </div>\n    <div>© <a href=\"https://wxgaochu.com\" target=\"_blank\" rel=\"noopener\">创作工作台（北京）教育咨询有限公司</a> | <a href=\"https://beian.miit.gov.cn/\" target=\"_blank\" rel=\"noopener\">京ICP备2025156498号-1</a> | 每个人的生命，都值得被用心记录</div>\n  </footer>\n\n  \n\n  <!-- 会员年度海报 · 大图灯箱 -->\n  <div class=\"poster-lightbox\" id=\"posterLightbox\" role=\"dialog\" aria-modal=\"true\" aria-label=\"会员年度海报大图预览\">\n    <div class=\"plb-hint\">会员年度海报 · 大图预览</div>\n    <div class=\"plb-bar\">\n      <span class=\"plb-count\" id=\"plbCount\" aria-live=\"polite\"></span>\n      <a class=\"plb-btn\" id=\"plbOpen\" href=\"#\" target=\"_blank\" rel=\"noopener\">↗ 新窗口打开</a>\n      <button class=\"plb-btn ghosty\" id=\"plbClose\" type=\"button\">✕ 关闭</button>\n    </div>\n    <button class=\"plb-nav is-prev\" id=\"plbPrev\" type=\"button\" aria-label=\"上一张海报\">‹</button>\n    <div class=\"plb-stage\"><img id=\"plbImg\" alt=\"\"></div>\n    <button class=\"plb-nav is-next\" id=\"plbNext\" type=\"button\" aria-label=\"下一张海报\">›</button>\n  </div>\n\n  \n\n  <aside class=\"visit-counter visit-counter--full\" data-vercount-counter=\"full\" aria-label=\"网站访问数据\" aria-live=\"polite\" data-vercount-state=\"loading\"><span class=\"visit-counter__heading\">网站足迹</span><span>本站访问 <strong data-vercount-site-pv=\"\">—</strong> 次</span><span class=\"visit-counter__separator\" aria-hidden=\"true\">·</span><span title=\"按浏览器 Cookie 去重，不代表注册会员数量\">独立访客 <strong data-vercount-site-uv=\"\">—</strong> 位</span><span class=\"visit-counter__separator\" aria-hidden=\"true\">·</span><span>本页浏览 <strong data-vercount-page-pv=\"\">—</strong> 次</span></aside>\n  \n\n\n<button type=\"button\" id=\"wxgc-share-btn\" aria-label=\"为当前页面生成分享短链\" style=\"position: fixed; right: 18px; bottom: 88px; z-index: 99998; min-height: 38px; padding: 9px 14px; border: 0px; border-radius: 999px; color: rgb(255, 255, 255); background: rgba(27, 100, 189, 0.92); cursor: pointer; font: 700 13px / 1.4 system-ui, -apple-system, &quot;PingFang SC&quot;, &quot;Microsoft YaHei&quot;, sans-serif; box-shadow: rgba(21, 47, 82, 0.24) 0px 8px 22px;\"><span>生成分享链接</span></button><a id=\"bottomBar\" style=\"position: fixed; bottom: -40px; left: 0px; z-index: 9999; transform: translateX(-50%); background-color: transparent; border-radius: 5px 5px 0px 0px; opacity: 0.3; padding: 5px; transition: 0.3s; cursor: pointer; max-height: 100px; max-width: 45px;\"><img src=\"chrome-extension://kobncfkmjelbefaoohoblamnbackjggk/icon/icon_32.png\" style=\"width: 32px; height: 32px;\"></a></body><plasmo-csui id=\"aitdk-csui\"></plasmo-csui><div id=\"immersive-translate-popup\" style=\"all: initial\"></div></html>", "controls": [{"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "放大查看：AI超级个体联盟年度实战会员主视觉", "value": "", "disabled": false, "attributes": [["data-poster-full", "../assets/img/cg-member-poster-1.jpg"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "放大查看：加入会员你将获得什么", "value": "", "disabled": false, "attributes": [["data-poster-full", "../assets/img/cg-member-poster-2.jpg"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "放大查看：这一年我们一起完成4件事", "value": "", "disabled": false, "attributes": [["data-poster-full", "../assets/img/cg-member-poster-3.jpg"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "放大查看：适合哪些人与全年交付节奏", "value": "", "disabled": false, "attributes": [["data-poster-full", "../assets/img/cg-member-poster-4.jpg"]]}, {"tag": "BUTTON", "id": "", "name": "", "type": "button", "text": "放大查看：谁在陪你一起实战", "value": "", "disabled": false, "attributes": [["data-poster-full", "../assets/img/cg-member-poster-5.jpg"]]}, {"tag": "BUTTON", "id": "wxgc-share-btn", "name": "", "type": "button", "text": "生成分享链接", "value": "", "disabled": false, "attributes": []}]}