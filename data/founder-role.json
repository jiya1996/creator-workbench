{"config":{"version":"2.0","source":"https://ipip.ori.org/newBigFive5broadKey.htm","questions":[{"id":"E1","text":"聚会时，我常常带动现场气氛。"},{"id":"A1","text":"我对别人的情况感兴趣。"},{"id":"C1","text":"做事情前，我通常会做好准备。"},{"id":"ES1","text":"大多数时候，我感觉放松。"},{"id":"O1","text":"我掌握的词汇比较丰富。"},{"id":"E2","text":"和别人在一起时，我感到自在。"},{"id":"A2","text":"我能体谅别人的感受。"},{"id":"C2","text":"我会留意细节。"},{"id":"ES2","text":"我很少感到低落。"},{"id":"O2","text":"我的想象力很生动。"},{"id":"E3","text":"我会主动开启话题。"},{"id":"A3","text":"看到别人遇到困难，我容易心软。"},{"id":"C3","text":"日常该做的事情，我会尽快做完。"},{"id":"ES3","text":"我容易感到压力。"},{"id":"O3","text":"我经常能想到不错的点子。"},{"id":"E4","text":"聚会时，我会和许多不同的人交谈。"},{"id":"A4","text":"我愿意抽时间帮助别人。"},{"id":"C4","text":"我喜欢把事情安排得有条理。"},{"id":"ES4","text":"我常常担心各种事情。"},{"id":"O4","text":"我理解新事物比较快。"},{"id":"E5","text":"成为大家注意的中心，我也不介意。"},{"id":"A5","text":"我能感受到别人的情绪。"},{"id":"C5","text":"我会按计划安排自己的时间。"},{"id":"ES5","text":"我容易被事情扰乱心情。"},{"id":"O5","text":"我会使用一些不太常见的词语。"},{"id":"E6","text":"我平时话不多。"},{"id":"A6","text":"和我相处时，别人容易感到自在。"},{"id":"C6","text":"我做事对准确和细致有要求。"},{"id":"ES6","text":"我很容易心烦。"},{"id":"O6","text":"我会花时间深入思考事情。"},{"id":"E7","text":"在人群里，我倾向于待在不显眼的位置。"},{"id":"A7","text":"我对别人的事情通常不太感兴趣。"},{"id":"C7","text":"我经常随手乱放自己的东西。"},{"id":"ES7","text":"我的心情经常变化。"},{"id":"O7","text":"我的脑子里经常有各种想法。"},{"id":"E8","text":"聊天时，我常觉得没什么可说的。"},{"id":"A8","text":"我有时会用伤人的话对待别人。"},{"id":"C8","text":"我常把东西弄得很乱。"},{"id":"ES8","text":"我的情绪经常起伏很大。"},{"id":"O8","text":"理解抽象的想法，对我来说比较困难。"},{"id":"E9","text":"我不喜欢让别人把注意力放在我身上。"},{"id":"A9","text":"我对别人遇到的问题不太感兴趣。"},{"id":"C9","text":"用完东西后，我经常忘记放回原处。"},{"id":"ES9","text":"我容易被惹恼。"},{"id":"O9","text":"我对抽象的想法不太感兴趣。"},{"id":"E10","text":"在陌生人面前，我通常比较安静。"},{"id":"A10","text":"我很少关心别人的处境。"},{"id":"C10","text":"我有时会逃避自己该做的事情。"},{"id":"ES10","text":"我经常感到低落。"},{"id":"O10","text":"我觉得自己的想象力不太丰富。"}],"roles":[{"id":"business_consultant","name":"商业顾问","reference":"华杉（华与华）","tagline":"把生意想明白"},{"id":"chief_expert","name":"首席专家","reference":"王传福（比亚迪）","tagline":"把专业做深"},{"id":"brand_owner","name":"品牌主理人","reference":"雷军（小米）","tagline":"让别人喜欢并记住我们"},{"id":"business_partner","name":"商务合伙人","reference":"徐小平（真格基金）","tagline":"把人和机会连接起来"},{"id":"sales_director","name":"销售总监","reference":"董明珠（格力）","tagline":"把目标拿下来"},{"id":"product_manager","name":"产品经理","reference":"张小龙（微信）","tagline":"把东西做得更好用"},{"id":"general_manager","name":"总经理","reference":"段永平","tagline":"让生意长期健康经营"},{"id":"operations_director","name":"运营总监","reference":"张勇（海底捞）","tagline":"把好想法真正跑起来"}]},"axes":{"O":"探索创新力","C":"目标执行力","E":"外部影响力","A":"关系协同力","ES":"压力稳定力"}}